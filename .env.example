# Copie para .env e preencha. NUNCA commitar o .env (ver .gitignore).

# --- Banco (compose sobe com esses valores por padrão) ---
RIOLIVE_DATABASE_URL=postgresql+psycopg://riolive:riolive@localhost:5432/riolive

# --- Redis ---
RIOLIVE_REDIS_URL=redis://localhost:6379/0

# --- Identificação do coletor (user-agent dos fetchers) ---
RIOLIVE_CONTATO=luciano@rheunion.com

# --- Alertas por e-mail (monitoramento de fontes) ---
# Sem SMTP_HOST configurado, alertas são só logados (modo dev).
RIOLIVE_SMTP_HOST=
RIOLIVE_SMTP_PORTA=587
RIOLIVE_SMTP_USUARIO=
RIOLIVE_SMTP_SENHA=
RIOLIVE_ALERTA_EMAIL_DESTINO=luciano@rheunion.com
RIOLIVE_ALERTA_COOLDOWN_MIN=30

# --- Dead-man's switch (healthchecks.io) ---
RIOLIVE_HEALTHCHECKS_URL=

# --- Sentry (free tier; vazio desativa) ---
RIOLIVE_SENTRY_DSN=

# --- Cloudflare R2 (blobs em produção; vazio = disco local em dados/blobs) ---
RIOLIVE_R2_ENDPOINT=
RIOLIVE_R2_ACCESS_KEY_ID=
RIOLIVE_R2_SECRET_ACCESS_KEY=
RIOLIVE_R2_BUCKET=

# --- Chaves de fontes (fase 1+; nenhuma das 3 primeiras fontes usa) ---
RIOLIVE_OPENAQ_API_KEY=
RIOLIVE_TOMTOM_API_KEY=
RIOLIVE_AISSTREAM_API_KEY=

# Camada de LLM (OpenRouter). Sem a chave, o enriquecimento por texto fica
# desligado e o resto do produto segue igual.
RIOLIVE_OPENROUTER_API_KEY=
# Padrão: anthropic/claude-sonnet-5 (escolhido por medição). Qualquer id do OpenRouter serve.
RIOLIVE_LLM_MODELO=
RIOLIVE_LLM_MAX_ITENS_POR_RODADA=

# BigQuery do datalake datario (backfill histórico de chuva)
RIOLIVE_GCP_PROJETO=
GOOGLE_APPLICATION_CREDENTIALS=
